# Copy to .env.local for development; set the same keys in Vercel → Settings → Environment Variables.
# Everything is optional in development: without keys, emails print to the console and
# orders/access are stored in .data/store.json.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://nexagen.ng
# SHOW_DRAFTS=1                      # show draft/scheduled content on a preview deployment
GOOGLE_SITE_VERIFICATION=            # Search Console HTML-tag token
BING_SITE_VERIFICATION=              # Bing Webmaster Tools token

# --- Auth (required in production) -------------------------------------------
AUTH_SECRET=                         # 32+ random chars: openssl rand -base64 48

# --- Database (required in production for courses & paid resources) ----------
DATABASE_URL=                        # any Postgres: Neon, Supabase, Vercel Postgres…

# --- Email: Resend ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Nexagen <hello@nexagen.ng>"   # verify nexagen.ng in Resend first
RESEND_AUDIENCE_ID=                  # newsletter audience

# --- Payments: Paystack -------------------------------------------------------
PAYSTACK_SECRET_KEY=                 # sk_test_… / sk_live_…  (webhook URL: https://nexagen.ng/api/paystack/webhook/ — note the trailing slash)

# --- Video (only the providers you use) --------------------------------------
MUX_SIGNING_KEY_ID=                  # for `signed: true` Mux videos (paid lessons)
MUX_SIGNING_PRIVATE_KEY=             # base64-encoded PEM from Mux → Signing keys
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=              # enables expiring token-authenticated embeds
